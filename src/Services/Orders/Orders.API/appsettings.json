{
  // Placeholders only. Real values come from appsettings.Development.json (local docker), user-secrets, or environment variables.
  // Never commit real secrets here.
  "ConnectionStrings": {
    "Database": ""
  },
  "JwtOptions": {
    "Issuer": "Starter",
    "Audience": "Starter",
    "Secret": "",
    "ValidForInMinutes": 60
  },
  "RabbitMqOptions": {
    "Host": "amqp://localhost:5672",
    "UserName": "guest",
